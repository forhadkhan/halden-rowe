---
/**
 * Form field (DESIGN.md 10.8): label above, optional hint (aria-describedby), control, error slot.
 * Validation messages ride on data attributes; Form.astro's script reads them:
 *   data-msg-required  shown when empty
 *   data-msg-invalid   shown when the browser's type/pattern check fails (email, tel)
 *   data-msg-too-long  shown past maxlength ({max} filled in)
 *   data-msg-past      date fields: shown for dates before today
 */
import Icon from './Icon.astro';

type Kind = 'text' | 'email' | 'tel' | 'date' | 'textarea' | 'select' | 'checkbox';

interface Props {
  name: string;
  label: string;
  type?: Kind;
  id?: string;
  hint?: string;
  /** Render the hint under the control instead of between label and control (keeps side-by-side controls level). */
  hintBelow?: boolean;
  required?: boolean;
  /** Text appended to optional fields' labels, e.g. "(optional)". Skipped if the label already says it. */
  optionalLabel?: string;
  autocomplete?: string;
  placeholder?: string;
  value?: string;
  options?: { value: string; label: string }[];
  /** First, empty option of a select. */
  placeholderOption?: string;
  maxlength?: number;
  rows?: number;
  pattern?: string;
  min?: string;
  checked?: boolean;
  messages?: { required?: string; invalid?: string; tooLong?: string; past?: string };
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  id = `field-${name}`,
  hint,
  hintBelow = false,
  required = false,
  optionalLabel,
  autocomplete,
  placeholder,
  value,
  options = [],
  placeholderOption,
  maxlength,
  rows = 6,
  pattern,
  min,
  checked = false,
  messages = {},
  class: className,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId].filter(Boolean).join(' ') || undefined;
const showOptional = !required && optionalLabel && !label.includes(optionalLabel);
const data = {
  'data-msg-required': messages.required,
  'data-msg-invalid': messages.invalid,
  'data-msg-too-long': messages.tooLong?.replace('{max}', String(maxlength ?? '')),
  'data-msg-past': messages.past,
  'data-error-id': errorId,
};
const common = {
  id,
  name,
  required,
  autocomplete,
  'aria-describedby': describedBy,
  ...data,
};
---

<div class:list={['field', `field--${type}`, className]} data-field>
  {
    type === 'checkbox' ? (
      <label class="field__check" for={id}>
        <input type="checkbox" value={value ?? 'yes'} checked={checked} {...common} />
        <span class="field__label">
          {label}
          {showOptional && <span class="muted"> {optionalLabel}</span>}
        </span>
      </label>
    ) : (
      <label class="field__label" for={id}>
        {label}
        {showOptional && <span class="muted"> {optionalLabel}</span>}
      </label>
    )
  }
  {hint && !hintBelow && <p id={hintId} class="field__hint">{hint}</p>}

  {type === 'textarea' && <textarea class="field__control" rows={rows} maxlength={maxlength} placeholder={placeholder} {...common}>{value}</textarea>}
  {
    type === 'select' && (
      <div class="field__select">
        <select class="field__control" {...common}>
          {placeholderOption !== undefined && <option value="">{placeholderOption}</option>}
          {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
        </select>
        <Icon name="chevron-down" size={20} class="field__chevron" />
      </div>
    )
  }
  {
    ['text', 'email', 'tel', 'date'].includes(type) && (
      <input
        class="field__control"
        type={type as 'text' | 'email' | 'tel' | 'date'}
        value={value}
        placeholder={placeholder}
        maxlength={maxlength}
        pattern={pattern}
        min={min}
        inputmode={type === 'tel' ? 'tel' : type === 'email' ? 'email' : undefined}
        {...common}
      />
    )
  }

  {hint && hintBelow && <p id={hintId} class="field__hint">{hint}</p>}

  <p id={errorId} class="field__error small" hidden>
    <Icon name="circle-alert" size={16} />
    <span data-error-text></span>
  </p>
</div>

<style is:global>
  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field__label {
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    color: var(--color-text);
  }

  .field__hint {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .field__control {
    width: 100%;
    min-height: 52px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-sm);
    background-color: var(--color-input-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-body);
    transition: border-color var(--dur-fast) var(--ease-standard);
  }

  .field__control::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  textarea.field__control {
    min-height: 144px;
    padding-block: var(--space-3);
    resize: vertical;
  }

  .field__control:hover {
    border-color: var(--color-text);
  }

  .field__control[aria-invalid="true"] {
    border-color: var(--color-error);
    box-shadow: inset 0 0 0 0.5px var(--color-error);
  }

  .field__control[readonly] {
    color: var(--color-text-muted);
  }

  .field__select {
    position: relative;
  }

  .field__select select {
    appearance: none;
    padding-inline-end: calc(var(--space-4) * 2 + 20px);
  }

  .field__chevron {
    position: absolute;
    top: 50%;
    right: var(--space-4);
    translate: 0 -50%;
    pointer-events: none;
  }

  .field__check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding-block: calc((var(--tap-min) - 20px) / 2 - 2px);
    cursor: pointer;
  }

  .field__check input {
    appearance: none;
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin: 2px 0 0;
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-xs);
    background-color: var(--color-input-bg);
  }

  .field__check input:checked {
    border-color: var(--color-text);
    background-color: var(--color-text);
  }

  /* Ivory check drawn with a rotated border: no icon font, no image. */
  .field__check input:checked::after {
    content: "";
    width: 6px;
    height: 11px;
    margin-top: -2px;
    border: solid var(--color-text-inverse);
    border-width: 0 2px 2px 0;
    rotate: 45deg;
  }

  .field__check input[aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .field--checkbox .field__hint {
    padding-inline-start: calc(20px + var(--space-3));
  }

  .field__error {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-error);
  }

  .field__error[hidden] {
    display: none;
  }

  .field__error .icon {
    margin-top: 0.15em;
  }

  @media (forced-colors: active) {
    .field__check input:checked {
      background-color: CanvasText;
    }

    .field__check input:checked::after {
      border-color: Canvas;
    }
  }
</style>
