---
/**
 * <head> metadata: title, description, canonical, Open Graph, Twitter card, robots, and a JSON-LD slot.
 * Pass `jsonLd` (one object or an array) or put <script type="application/ld+json"> in the "json-ld" slot.
 */
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { getCopy, hasCopy, type SeoCopy } from '../data/load-copy';
import { url } from '../lib/url';
import { getPhoto } from '../lib/photos';

interface Props {
  /** Full title as Quill wrote it, or a short title run through seo.json's titleTemplate when `template` is true. */
  title: string;
  description: string;
  template?: boolean;
  /** Path (without base) for the canonical URL; defaults to the current page. */
  path?: string;
  /** Manifest path of the share photo; defaults to site.defaultOgPhoto. */
  image?: string;
  imageAlt?: string;
  /**
   * Path (without base) of a generated 1200x630 share card from src/pages/og/[name].jpg.ts, e.g.
   * "/og/loft-chicago.jpg". Wins over `image`. Pages that pass neither get "/og/default.jpg".
   */
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const seo: SeoCopy | undefined = hasCopy('seo') ? getCopy('seo') : undefined;
const {
  title,
  description,
  template = false,
  path,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;
const generated = Astro.props.ogImage ?? (image ? undefined : '/og/default.jpg');

const blocked = noindex || !site.indexable;
const fullTitle = template && seo ? seo.titleTemplate.replace('{title}', title) : title;
const canonical = Astro.site ? new URL(path ? url(path) : Astro.url.pathname, Astro.site).href : undefined;

let ogImage: string | undefined;
let ogAlt = imageAlt;
if (Astro.site && generated) {
  ogImage = new URL(url(generated), Astro.site).href;
  ogAlt ??= seo?.defaultOgImageAlt;
} else if (Astro.site) {
  const { entry, image: source } = getPhoto(image ?? site.defaultOgPhoto);
  const og = await getImage({ src: source, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  ogImage = new URL(og.src, Astro.site).href; // og.src already carries the base
  ogAlt ??= entry.alt;
}
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// `<` escaped so a copy string can never close the script element.
const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && !blocked && <link rel="canonical" href={canonical} />}
{blocked && <meta name="robots" content="noindex, nofollow, noarchive" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={seo?.locale ?? site.locale.replace('-', '_')} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && !noindex && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && ogAlt && <meta property="og:image:alt" content={ogAlt} />}

<meta name="twitter:card" content="summary_large_image" />
{seo?.twitterHandle && <meta name="twitter:site" content={seo.twitterHandle} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}

{ldBlocks.map((block) => <script type="application/ld+json" set:html={ldJson(block)} />)}
<slot name="json-ld" />
