---
/**
 * Team grid for /about#team (DESIGN.md 11.4 part 6 = H9 agents + a one-line bio). Portrait 4:5, name, role,
 * bio, call and email icon buttons (44px), listings count on a dimension line. 1 column on phones (one card per row), 3 from 768.
 * Name and role sit on the portrait over an ink fade; bio and actions stay below. M6 batch reveal; the photo scales 1.03 on hover.
 */
import Photo from '../Photo.astro';
import Button from '../Button.astro';
import DimensionLine from '../DimensionLine.astro';
import { fmt, getCopy, plural, type Plural } from '../../data/load-copy';
import { cropFor } from '../property/crops';

interface Props {
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { agents } = getCopy('agents');
const a11y = getCopy('site').a11y;
const counts = getCopy<{ agents: { listingsCount: Plural } }>('home').agents.listingsCount;
const listings = getCopy('properties').listings;
---

<ul class="team" role="list">
  {
    agents.map((agent) => {
      const count = listings.filter((l) => l.agentId === agent.id).length;
      return (
        <li class="team__member" data-reveal>
          <div class="team__portrait">
            <Photo
              src={agent.photo}
              alt={agent.alt}
              sizes="(min-width: 48rem) 30vw, 92vw"
              widths={[320, 480, 720]}
              position={cropFor(agent.photo)}
            />
            <div class="team__caption">
              <Heading class="title team__name">{agent.name}</Heading>
              <p class="small team__role">{agent.role}</p>
            </div>
          </div>
          <p class="small team__bio">{agent.bioShort}</p>
          <div class="team__foot">
            <div class="team__actions">
              <Button variant="icon" icon="phone" href={agent.phoneHref} label={fmt(a11y.phoneLinkPattern, { name: agent.name })} magnetic={false} />
              <Button variant="icon" icon="mail" href={`mailto:${agent.email}`} label={fmt(a11y.emailLinkPattern, { name: agent.name })} magnetic={false} />
            </div>
            {count > 0 && <DimensionLine as="span" align="start" label={fmt(plural(count, counts), { count })} class="team__count" />}
          </div>
        </li>
      );
    })
  }
</ul>

<style is:global>
  .team {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12) var(--space-gutter);
    margin: 0;
  }

  .team__portrait {
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: var(--radius-sm);
    background-color: var(--color-skeleton);
  }

  .team__portrait .photo,
  .team__portrait .photo-img {
    width: 100%;
    height: 100%;
  }

  .team__portrait .photo-img {
    object-fit: cover;
    object-position: var(--photo-position, 50% 20%);
    transition: scale var(--dur-slow) var(--ease-standard);
  }

  @media (hover: hover) {
    .motion-ok .team__member:hover .photo-img {
      scale: 1.03;
    }
  }

  .team__portrait {
    position: relative;
  }

  /* Ink fade (not pure black) so the caption reads on any portrait; colours are fixed because the photo is the same in both schemes. */
  .team__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-16) var(--space-5) var(--space-5);
    background: linear-gradient(to top, rgb(26 30 29 / 0.82) 0%, rgb(26 30 29 / 0.64) 45%, rgb(26 30 29 / 0) 100%);
    color: #ece8df;
    pointer-events: none;
  }

  .team__name {
    margin: 0;
    color: inherit;
    font-size: var(--text-title);
    line-height: 1.25;
  }

  .team__role {
    margin: var(--space-1) 0 0;
    color: rgb(236 232 223 / 0.94);
    font-size: var(--text-small);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .team__bio {
    margin: var(--space-3) 0 0;
  }

  .team__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
  }

  .team__actions {
    display: flex;
    gap: var(--space-1);
    margin-left: calc(var(--space-2) * -1);
  }

  .team__count {
    flex: 1 1 8rem;
  }

  @media (min-width: 48rem) {
    .team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
