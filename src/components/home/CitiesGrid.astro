---
/**
 * H5b Cities: the twelve cities, two per row, each with its state's outline as the icon. Every row links to
 * /properties?city=<name>. Outlines come from state-shapes.ts, drawn once as <symbol>s and reused.
 */
import DimensionLine from '../DimensionLine.astro';
import { getCopy, fmt } from '../../data/load-copy';
import { url } from '../../lib/url';
import { stateShapes } from './state-shapes';
import type { HomeCopy } from './types';

const { marquee: cities } = getCopy<HomeCopy>('home');
const used = [...new Set(cities.items.map((c) => c.state))];
---

<section class="cities section" aria-labelledby="cities-title">
  <div class="container">
    <DimensionLine as="p" label={cities.eyebrow} align="start" class="cities__eyebrow" />
    <h2 id="cities-title" class="visually-hidden">{cities.label}</h2>
    <svg width="0" height="0" class="cities__defs" aria-hidden="true" focusable="false">
      {used.map((code) => <symbol id={`state-${code}`} viewBox="0 0 48 48"><path d={stateShapes[code].d} /></symbol>)}
    </svg>
    <ul class="cities__grid" role="list" data-ambient>
      {
        cities.items.map((city, i) => (
          <li class="city" data-reveal style={`--i: ${i}`}>
            <a
              class="city__link"
              href={url(`/properties?city=${encodeURIComponent(city.name)}`)}
              aria-label={fmt(cities.linkLabel, { city: city.name })}
            >
              <svg class="city__shape" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <use href={`#state-${city.state}`} />
                <use href={`#state-${city.state}`} class="city__shine" />
              </svg>
              <span class="city__text">
                <span class="display-s city__name">{city.name}</span>
                <span class="small muted city__state">{stateShapes[city.state].name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  .cities__defs {
    position: absolute;
  }

  .cities__eyebrow {
    margin-bottom: var(--space-8);
  }

  .cities__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cities__grid > li {
    display: flex;
  }

  .city__link {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: 5rem;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .city__link:hover {
    background-color: var(--color-surface);
  }

  .city__shape {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    fill: var(--color-map-land);
    stroke: var(--color-accent-graphic);
    stroke-width: 1.25;
    stroke-linejoin: round;
    transition: fill var(--dur-base) var(--ease-standard);
  }

  .city__link:hover .city__shape {
    fill: var(--color-accent-line);
  }

  /* M33 shimmer: a lighter copy of each outline glows in and out, one tile after another (opacity only). */
  .city__shine {
    fill: none;
    stroke: var(--hr-brass-300);
    stroke-width: 2;
    opacity: 0;
  }

  .motion-ok .city__shine {
    animation: city-shimmer var(--dur-shine) var(--ease-in-out) calc(var(--i, 0) * 0.5s) infinite;
    animation-play-state: var(--ambient-play, running);
  }

  @keyframes city-shimmer {
    0%,
    30%,
    100% {
      opacity: 0;
    }

    15% {
      opacity: 0.9;
    }
  }

  .city__text {
    display: grid;
    min-width: 0;
  }

  .city__name {
    font-size: var(--text-title);
    line-height: var(--leading-title);
    overflow-wrap: anywhere;
  }

  @media (min-width: 30rem) {
    .city__link {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 48rem) {
    .cities__grid {
      gap: var(--space-5);
    }

    .city__link {
      gap: var(--space-5);
      min-height: 7rem;
      padding: var(--space-5);
    }

    .city__shape {
      width: 4.5rem;
      height: 4.5rem;
    }

    .city__name {
      font-size: var(--text-display-s);
      line-height: var(--leading-display-s);
    }
  }
</style>
