# Copy to .env for local use. Nothing here is secret: every value ends up in the public build.

# Absolute origin the site is served from (canonical URLs, Open Graph, sitemap). Required for `npm run build`:
# the build stops with an error when it is empty. `npm run dev` falls back to http://localhost:4321.
SITE_URL=https://example.com

# Path the site lives under. "/" for Cloudflare Pages or a custom domain; "/<repo-name>" for a GitHub Pages project site.
BASE_PATH=/

# Form endpoint (Web3Forms or Formspree compatible). Leave empty for demo mode: forms validate and show a
# "Demo site: nothing was sent" note instead of posting.
PUBLIC_FORM_ENDPOINT=

# Web3Forms only: the public access key (it is meant to be in client code). Leave empty for Formspree.
PUBLIC_FORM_ACCESS_KEY=
